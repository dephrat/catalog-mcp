# Secrets — the glob matters: .env.swp slipped past a bare ".env" rule once
.env
.env.*
!.env.example

# Editor swap/backup files. A vim swap file on .env contains the secret
# in binary form, which text-diff scanning does not catch.
*.swp
*.swo
*.swn
*~
.*.sw?
*.bak
*.orig

# Databases and dumps — these hold real mailbox contents
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.backup
*.sqlite
*.sqlite3
*.json.gz

# Python
__pycache__/
*.pyc
.venv/
venv/
.venv-mcp/

# Local tooling
.claude/
demo_catalog.db

# Session-continuity notes. Not documentation, and it names the private
# archive repo — this repo is public, so it stays on disk only.
HANDOFF.md

# OS
.DS_Store

# Benchmark artifacts carry real mailbox contents and personal ground truth
bench/results.jsonl
bench/questions.json
bench/mcp-*.json
bench/questions2.json
